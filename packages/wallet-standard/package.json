{
  "name": "@glow-xyz/wallet-standard",
  "version": "1.1.0",
  "private": false,
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "typings": "dist/types/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "tsc": "tsc --noEmit",
    "release": "bun run build && release-it"
  },
  "dependencies": {
    "@glow-xyz/glow-client": "^1.5.0",
    "@solana/wallet-standard-features": "^1.0.0",
    "@wallet-standard/base": "^1.0.1",
    "@wallet-standard/features": "^1.0.1",
    "bs58": "^5.0.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^18.11.10",
    "typescript": "^5.6.3"
  }
}
