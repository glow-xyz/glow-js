{
  "name": "@glow-xyz/solana-client",
  "version": "1.9.0",
  "private": false,
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glow-xyz/glow-js.git",
    "directory": "packages/solana-client"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "!**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "typings": "dist/types/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "bun test src",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json"
  },
  "dependencies": {
    "@glow-xyz/beet": "0.6.0",
    "@noble/ed25519": "^1.7.1",
    "@noble/hashes": "^1.1.3",
    "bignumber.js": "^9.1.1",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "buffer": "^6.0.3",
    "js-sha256": "^0.9.0",
    "luxon": "^3.0.4",
    "p-limit": "^3.0.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.19.1"
  },
  "devDependencies": {
    "@solana/web3.js": "1.99.0",
    "@types/bn.js": "5.2.0",
    "@types/bun": "1.4.2",
    "@types/luxon": "3.7.6",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
