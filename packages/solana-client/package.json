{
  "name": "@glow-xyz/solana-client",
  "version": "1.8.0",
  "private": false,
  "license": "ISC",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "typings": "dist/types/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "bun test src",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "release": "bun run build && release-it"
  },
  "dependencies": {
    "@glow-xyz/beet": "0.6.0",
    "@noble/ed25519": "^1.7.1",
    "@noble/hashes": "^1.1.3",
    "axios": "^0.27.2",
    "bignumber.js": "^9.1.1",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "buffer": "^6.0.3",
    "js-sha256": "^0.9.0",
    "lodash": "^4.17.21",
    "luxon": "^3.0.4",
    "p-limit": "^3.0.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.19.1"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.63.1",
    "@types/bn.js": "5.1.1",
    "@types/bun": "1.3.1",
    "@types/lodash": "4.14.191",
    "@types/luxon": "3.1.0",
    "esbuild": "0.15.17",
    "typescript": "5.6.3"
  }
}
